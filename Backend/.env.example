# ── App ──────────────────────────────────────
APP_NAME=RecruitAI
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# ── Database ─────────────────────────────────
# SQLite (dev)
DATABASE_URL=sqlite+aiosqlite:///./recruitai.db

# PostgreSQL (prod) — uncomment and set:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/recruitai

# ── JWT ──────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AI Provider ──────────────────────────────
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...   # Alternative

# ── File Storage ─────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── CORS ─────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000